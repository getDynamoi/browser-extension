{
	"name": "@dynamoi/chrome-extension",
	"version": "1.0.0",
	"description": "Displays enhanced music data on Spotify's web app. Quickly see popularity, genres, label, and UPC as you browse.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"typecheck": "bun ../../scripts/validate/with-heavy-slot.ts --class typecheck --wait-timeout-minutes 60 -- tsc --noEmit -p tsconfig.json",
		"lint": "echo 'no lint configured'",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "catalog:",
		"@types/chrome": "0.1.43",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@wxt-dev/module-react": "1.2.2",
		"postcss": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"wxt": "0.21.4"
	}
}
