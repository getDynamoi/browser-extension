{
	"name": "@dynamoi/chrome-extension",
	"version": "2.0.0",
	"description": "Free Dynamoi release lookup: ISRC or UPC, label, release date, credited artists and store links for any Spotify album or track.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"typecheck": "tsrs --noEmit -p tsconfig.json",
		"lint": "echo 'no lint configured'",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "catalog:",
		"@types/chrome": "0.1.43",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@wxt-dev/module-react": "1.2.2",
		"postcss": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"wxt": "0.21.4"
	}
}
